                "Logistic Regression",
                "Random Forest",
                "XGBoost"
            ],
            value="XGBoost",
            label="Model"
        )

        export_threshold = gr.Slider(
            0.05, 0.95,
            value=0.5,
            step=0.05,
            label="Threshold"
        )

        export_button = gr.Button(
            "Generate Prediction CSV",
            variant="primary"
        )

        export_file = gr.File(label="Download predictions")

        export_button.click(
            export_predictions,
            inputs=[export_model, export_threshold],
            outputs=[export_file]
        )

    gr.Markdown("""
