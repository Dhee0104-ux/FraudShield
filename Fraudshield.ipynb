# 4. SYNTHETIC DEMO DATASET
def create_demo_dataset(n_samples=12000, n_features=20):
    X, y = make_classification(
        n_samples=n_samples,
        n_features=n_features,
        n_informative=10,
        n_redundant=5,
        n_classes=2,
        weights=[0.985, 0.015],
        flip_y=0.005,
        class_sep=1.0,
        random_state=42
    )

    df = pd.DataFrame(
        X,
        columns=[f"Feature_{i+1}" for i in range(n_features)]
    )
    df.insert(0, "TransactionID", np.arange(1, n_samples + 1))
    df["Amount"] = np.random.default_rng(42).lognormal(
        mean=3, sigma=1, size=n_samples
    )
    df["Class"] = y
    return df

# 5. LOAD DATASET
def load_dataset(file, use_demo):
    try:
        if use_demo or file is None:
            df = create_demo_dataset()
            source = "Synthetic demo dataset"
        else:
            path = file.name if hasattr(file, "name") else str(file)
            if not path.lower().endswith(".csv"):
                raise ValueError("Please upload a CSV file.")
            df = pd.read_csv(path)
            source = "Uploaded CSV"

        if df.empty or len(df.columns) < 2:
            raise ValueError("Dataset must contain features and a target.")

        columns = list(df.columns)
        target = "Class" if "Class" in columns else columns[-1]

        summary = f"""
## Dataset Loaded

- **Source:** {source}
- **Rows:** {len(df):,}
- **Columns:** {len(df.columns)}
- **Missing values:** {df.isna().sum().sum():,}

Choose the target column containing fraud labels.
Use 1 for fraud and 0 for legitimate transactions.
"""
        return (
            df,
            gr.update(choices=columns, value=target),
            df.head(10),
            summary
        )
    except Exception as e:
        return None, gr.update(choices=[], value=None), pd.DataFrame(), f"Error: {e}"

# 6. PREPROCESSING
def prepare_data(df, target_column, test_size=0.2):
    if df is None:
        raise ValueError("Load a dataset first.")

    if target_column not in df.columns:
        raise ValueError("Choose a valid target column.")

    data = df.dropna(subset=[target_column]).copy()
    raw_y = data[target_column]

    if set(pd.Series(raw_y).unique()).issubset({0, 1, 0.0, 1.0}):
        y = raw_y.astype(int)
    else:
        labels = raw_y.astype(str).str.strip().str.lower()
        positive = {
            "fraud", "fraudulent", "yes", "true", "positive", "1"
        }
        negative = {
            "legitimate", "genuine", "normal", "no", "false",
            "negative", "0", "not fraud", "non-fraud"
        }

        if not set(labels.unique()).issubset(positive | negative):
            raise ValueError(
                "Target must contain binary 0/1 labels or recognized "
                "fraud/legitimate labels."
            )

        y = labels.map(lambda v: 1 if v in positive else 0).astype(int)

    X = data.drop(columns=[target_column])

    # Drop obvious identifiers to reduce memorization.
    id_columns = [
        c for c in X.columns
        if c.lower() in {
            "id", "transactionid", "transaction_id",
            "customerid", "customer_id", "index"
        }
    ]
    X = X.drop(columns=id_columns, errors="ignore")

    # Encode categorical columns.
    categorical = X.select_dtypes(
        include=["object", "category", "bool"]
    ).columns.tolist()

    X = pd.get_dummies(
        X,
        columns=categorical,
        dummy_na=True,
        dtype=float
    )

    X = X.replace([np.inf, -np.inf], np.nan)
    X = X.apply(pd.to_numeric, errors="coerce")
    X = X.dropna(axis=1, how="all")
    X = X.loc[:, X.nunique(dropna=False) > 1]

    if X.shape[1] == 0:
        raise ValueError("No usable feature columns remain.")

    if y.nunique() != 2:
        raise ValueError("Target must contain exactly two classes.")

    if y.value_counts().min() < 2:
        raise ValueError("Each class needs at least two examples.")

    X_train, X_test, y_train, y_test = train_test_split(
        X, y,
        test_size=test_size,
        random_state=42,
        stratify=y
    )

    return X_train, X_test, y_train, y_test

# 7. BUILD MODELS
def build_models(y_train):
    counts = y_train.value_counts()
    negatives = int(counts.get(0, 0))
    positives = int(counts.get(1, 0))

    if positives == 0:
        raise ValueError("No fraud examples found.")

    ratio = negatives / positives

    return {
        "Logistic Regression": Pipeline([
            ("imputer", SimpleImputer(strategy="median")),
            ("scaler", StandardScaler()),
            ("classifier", LogisticRegression(
                max_iter=2000,
                class_weight="balanced",
                random_state=42
            ))
        ]),

        "Random Forest": Pipeline([
            ("imputer", SimpleImputer(strategy="median")),
            ("classifier", RandomForestClassifier(
                n_estimators=250,
                min_samples_leaf=2,
                class_weight="balanced",
                n_jobs=-1,
                random_state=42
            ))
        ]),

        "XGBoost": Pipeline([
            ("imputer", SimpleImputer(strategy="median")),
            ("classifier", XGBClassifier(
                n_estimators=250,
                max_depth=5,
                learning_rate=0.05,
                subsample=0.85,
                colsample_bytree=0.85,
                scale_pos_weight=ratio,
                eval_metric="aucpr",
                n_jobs=-1,
                random_state=42
            ))
        ])
    }

# 8. METRICS
def calculate_metrics(y_true, probabilities, threshold=0.5):
    predictions = (probabilities >= threshold).astype(int)

    return {
        "Precision": precision_score(
            y_true, predictions, zero_division=0
        ),
        "Recall": recall_score(
            y_true, predictions, zero_division=0
        ),
        "F1-Score": f1_score(
            y_true, predictions, zero_division=0
        ),
        "PR-AUC": average_precision_score(
            y_true, probabilities
        ),
        "ROC-AUC": roc_auc_score(
            y_true, probabilities
        ),
        "Accuracy": accuracy_score(y_true, predictions)
    }

# 9. VISUALIZATIONS
def plot_model_comparison(results):
    df = pd.DataFrame(results).T
    fig, ax = plt.subplots(figsize=(10, 5))

    df[["Precision", "Recall", "F1-Score", "PR-AUC"]].plot(
        kind="bar", ax=ax
    )

    ax.set_title("FraudShield Model Comparison")
    ax.set_ylabel("Score")
    ax.set_ylim(0, 1)
    ax.grid(axis="y", alpha=0.25)
    plt.xticks(rotation=15)
    plt.tight_layout()
    return fig

def plot_pr_curves(result_data):
    fig, ax = plt.subplots(figsize=(8, 6))

    for name, item in result_data.items():
        precision, recall, _ = precision_recall_curve(
            item["y_true"], item["probabilities"]
        )
        ap = average_precision_score(
            item["y_true"], item["probabilities"]
        )
        ax.plot(recall, precision, label=f"{name} (AP={ap:.4f})")

    ax.set_title("Precision–Recall Curves")
    ax.set_xlabel("Recall")
    ax.set_ylabel("Precision")
    ax.set_xlim(0, 1)
    ax.set_ylim(0, 1.02)
    ax.grid(alpha=0.25)
    ax.legend()
    plt.tight_layout()
    return fig

def plot_cm(y_true, probabilities, threshold):
    predictions = (probabilities >= threshold).astype(int)
    cm = confusion_matrix(y_true, predictions, labels=[0, 1])

    fig, ax = plt.subplots(figsize=(6, 5))
    sns.heatmap(
        cm, annot=True, fmt=",", cmap="Blues",
        xticklabels=["Legitimate", "Fraud"],
        yticklabels=["Legitimate", "Fraud"],
        ax=ax
    )
    ax.set_xlabel("Predicted")
    ax.set_ylabel("Actual")
    ax.set_title("Confusion Matrix")
    plt.tight_layout()
    return fig

# 10. TRAIN ALL MODELS
def train_fraudshield(
    file, use_demo, target_column,
    imbalance_method, model_choice, threshold
):
    try:
        if use_demo or file is None:
            df = create_demo_dataset()
        else:
            path = file.name if hasattr(file, "name") else str(file)
            df = pd.read_csv(path)

        if target_column not in df.columns:
            target_column = "Class" if "Class" in df.columns else df.columns[-1]

        X_train, X_test, y_train, y_test = prepare_data(
            df, target_column
        )

        X_fit = X_train.copy()
        y_fit = y_train.copy()

        # Resampling is performed only on the training set.
        if imbalance_method == "SMOTE":
            minority_count = int(y_fit.value_counts().min())
            if minority_count < 2:
                raise ValueError("SMOTE requires at least two minority samples.")

            smote = SMOTE(
                random_state=42,
                k_neighbors=min(5, minority_count - 1)
            )
            X_fit, y_fit = smote.fit_resample(X_fit, y_fit)

        models = build_models(y_train)
        trained = {}
        results = {}
        result_data = {}

        for name, model in models.items():
            print(f"Training {name}...")
            model.fit(X_fit, y_fit)

            probabilities = model.predict_proba(X_test)[:, 1]

            trained[name] = model
            results[name] = calculate_metrics(
                y_test, probabilities, threshold
            )
            result_data[name] = {
                "y_true": y_test.to_numpy(),
                "probabilities": probabilities
            }

        STATE.update({
            "models": trained,
            "results": results,
            "X_train": X_train,
            "X_test": X_test,
            "y_train": y_train,
            "y_test": y_test,
            "feature_names": list(X_train.columns),
            "target": target_column
        })

        if model_choice not in trained:
            model_choice = "XGBoost"

        selected_probabilities = result_data[model_choice]["probabilities"]

        metrics_df = pd.DataFrame(results).T.reset_index()
        metrics_df = metrics_df.rename(columns={"index": "Model"})
        for col in metrics_df.columns:
            if col != "Model":
                metrics_df[col] = metrics_df[col].round(4)

        report = classification_report(
            y_test,
            (selected_probabilities >= threshold).astype(int),
            target_names=["Legitimate", "Fraud"],
            zero_division=0
        )

        summary = f"""
# Training Complete

**Selected model:** {model_choice}

- Training rows: {len(X_train):,}
- Testing rows: {len(X_test):,}
- Features: {X_train.shape[1]}
- Threshold: {threshold:.2f}
- Imbalance handling: {imbalance_method}

### Classification Report

PR-AUC is average precision. Accuracy alone can be misleading
when fraudulent transactions are rare.
"""

        return (
            summary,
            metrics_df,
            plot_model_comparison(results),
            plot_pr_curves(result_data),
            plot_cm(y_test, selected_probabilities, threshold),
            "Training completed successfully."
        )

    except Exception as e:
        traceback.print_exc()
        return (
            f"## Training failed\n\n`{e}`",
            pd.DataFrame(),
            None, None, None,
            f"Error: {e}"
        )

# 11. FALSE POSITIVE ANALYSIS
def analyze_false_positives(model_name, threshold):
    try:
        if not STATE["models"]:
            return pd.DataFrame(), "Train the models first."

        model = STATE["models"][model_name]
        X_test = STATE["X_test"]
        y_test = STATE["y_test"]

        probabilities = model.predict_proba(X_test)[:, 1]
        predictions = (probabilities >= threshold).astype(int)

        actual = y_test.to_numpy()
        mask = (actual == 0) & (predictions == 1)

        fp = X_test.loc[mask].copy()
        fp["Actual"] = "Legitimate"
        fp["Predicted"] = "Fraud"
        fp["FraudProbability"] = probabilities[mask]

        fp = fp.sort_values(
            "FraudProbability", ascending=False
        ).head(100).reset_index(drop=True)

        total_fp = int(mask.sum())
        total_legitimate = int((actual == 0).sum())

        summary = f"""
## False Positive Analysis

- False positives: **{total_fp:,}**
- Actual legitimate transactions: **{total_legitimate:,}**
- False-positive rate: **{total_fp / max(total_legitimate, 1):.2%}**
- Model: {model_name}
- Threshold: {threshold:.2f}

A false positive is a legitimate transaction incorrectly flagged as fraud.
"""
        return fp, summary

    except Exception as e:
        return pd.DataFrame(), f"Error: {e}"

# 12. SHAP EXPLANATION
def explain_transaction(model_name, row_index):
    try:
        if not STATE["models"]:
            return None, "Train the models first."

        X_test = STATE["X_test"]
        y_test = STATE["y_test"]
        model = STATE["models"][model_name]

        row_index = int(row_index)

        if not 0 <= row_index < len(X_test):
            raise ValueError(
                f"Choose a row from 0 to {len(X_test)-1}."
            )

        background = X_test.sample(
            min(40, len(X_test)),
            random_state=42
        )
        row = X_test.iloc[[row_index]]

        def predict_probability(data):
            data = pd.DataFrame(
                data, columns=X_test.columns
            )
            return model.predict_proba(data)[:, 1]

        explainer = shap.Explainer(
            predict_probability,
            background,
            algorithm="permutation"
        )

        explanation = explainer(
            row,
            max_evals=2 * X_test.shape[1] + 1
        )

        values = np.asarray(explanation.values).reshape(-1)

        shap_df = pd.DataFrame({
            "Feature": X_test.columns,
            "SHAP Value": values,
            "Transaction Value": row.iloc[0].values
        })

        shap_df["Absolute Impact"] = shap_df["SHAP Value"].abs()
        top = shap_df.nlargest(15, "Absolute Impact")
        top = top.sort_values("SHAP Value")

        fig, ax = plt.subplots(figsize=(10, 6))
        ax.barh(top["Feature"], top["SHAP Value"])
        ax.axvline(0, linewidth=1)
        ax.set_title("SHAP Feature Contributions")
        ax.set_xlabel("Impact on fraud probability")
        ax.grid(axis="x", alpha=0.25)
        plt.tight_layout()

        probability = float(model.predict_proba(row)[0, 1])
        threshold = 0.5
        predicted = int(probability >= threshold)
        actual = int(y_test.iloc[row_index])

        text = f"""
## Transaction Explanation

- Test row: {row_index}
- Fraud probability: **{probability:.2%}**
- Threshold: {threshold:.2%}
- Prediction: **{"FRAUD" if predicted else "LEGITIMATE"}**
- Actual label: **{"Fraud" if actual else "Legitimate"}**

Positive SHAP values push the prediction toward fraud.
Negative SHAP values push it away from fraud.

SHAP explains the model's behavior; it does not establish the true
cause of a transaction or prove fraud.
"""
        return fig, text

    except Exception as e:
        traceback.print_exc()
        return None, f"SHAP explanation failed: {e}"

# 13. THRESHOLD ANALYSIS
def threshold_analysis(model_name):
    try:
        if not STATE["models"]:
            return pd.DataFrame(), None, "Train the models first."

        model = STATE["models"][model_name]
        X_test = STATE["X_test"]
        y_test = STATE["y_test"]

        probabilities = model.predict_proba(X_test)[:, 1]
        actual = y_test.to_numpy()
        rows = []

        for t in np.arange(0.05, 1.00, 0.05):
            pred = (probabilities >= t).astype(int)

            rows.append({
                "Threshold": round(float(t), 2),
                "Precision": precision_score(
                    actual, pred, zero_division=0
                ),
                "Recall": recall_score(
                    actual, pred, zero_division=0
                ),
                "F1-Score": f1_score(
                    actual, pred, zero_division=0
                ),
                "False Positives": int(
                    ((actual == 0) & (pred == 1)).sum()
                ),
                "False Negatives": int(
                    ((actual == 1) & (pred == 0)).sum()
                )
            })

        df = pd.DataFrame(rows)

        fig, ax = plt.subplots(figsize=(9, 5))
        for metric in ["Precision", "Recall", "F1-Score"]:
            ax.plot(df["Threshold"], df[metric], marker="o", label=metric)

        ax.set_xlabel("Fraud probability threshold")
        ax.set_ylabel("Score")
        ax.set_title("Threshold Analysis")
        ax.set_ylim(0, 1.05)
        ax.grid(alpha=0.25)
        ax.legend()
        plt.tight_layout()

        note = (
            "A lower threshold usually catches more fraud but creates "
            "more false alarms. Choose the threshold using validation "
            "data and the costs of missed fraud versus unnecessary reviews."
        )

        return df.round(4), fig, note

    except Exception as e:
        return pd.DataFrame(), None, f"Error: {e}"

# 14. EXPORT PREDICTIONS
def export_predictions(model_name, threshold):
    if not STATE["models"]:
        raise gr.Error("Train the models first.")

    model = STATE["models"][model_name]
    X_test = STATE["X_test"].copy()

    probabilities = model.predict_proba(X_test)[:, 1]
    predictions = (probabilities >= threshold).astype(int)

    output = X_test.copy()
    output["Actual"] = STATE["y_test"].to_numpy()
    output["FraudProbability"] = probabilities
    output["PredictedClass"] = predictions
    output["Prediction"] = np.where(
        predictions == 1, "Fraud", "Legitimate"
    )

    path = os.path.join(
        tempfile.gettempdir(),
        "fraudshield_predictions.csv"
    )
    output.to_csv(path, index=False)
    return path

